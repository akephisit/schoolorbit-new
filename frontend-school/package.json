{
	"name": "frontend-school",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"sync:menu-routes": "node --experimental-strip-types scripts/register-menu-routes.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate:api-contracts": "node ../scripts/generate-api-contracts.mjs",
		"check:api-contracts": "node ../scripts/generate-api-contracts.mjs --check",
		"test:api-contracts": "node --test ../scripts/tests/generate-api-contracts.test.mjs",
		"generate:permissions": "node ../scripts/generate-permissions.mjs",
		"check:permissions": "node ../scripts/generate-permissions.mjs --check",
		"test:permissions": "node --test ../scripts/tests/generate-permissions.test.mjs",
		"check:docs": "node --test tests/static/documentation-policy.test.mjs",
		"test:static": "node --test tests/static/*.test.mjs",
		"test:menu-sync": "node --test tests/runtime/menu-route-registration.test.mjs",
		"test:route-loading": "node --test tests/static/route-data-loading-inventory.test.mjs tests/static/route-data-loading-policy.test.mjs",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"@types/pdfmake": "^0.3.3",
		"@types/qrcode": "^1.5.6",
		"clsx": "^2.1.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"glob": "^13.0.6",
		"globals": "^17.13.0",
		"jsqr": "^1.4.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"wrangler": "^4.151.3",
		"yaml": "2.9.1"
	},
	"dependencies": {
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-file-handler": "^3.32.0",
		"@tiptap/extension-placeholder": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"@vladmandic/face-api": "1.7.15",
		"bits-ui": "^2.20.0",
		"compressorjs": "^1.4.0",
		"date-fns": "^4.4.0",
		"docx": "^9.13.0",
		"exceljs": "^4.4.0",
		"heic2any": "^0.0.4",
		"katex": "^0.19.0",
		"mathlive": "^0.111.1",
		"mathml2omml": "^0.5.0",
		"mobile-drag-drop": "^3.0.0-rc.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.4.299",
		"pdfmake": "^0.3.12",
		"qrcode": "^1.5.4",
		"ssf": "^0.11.2",
		"svelte-sonner": "^1.2.1",
		"zod": "^4.6.7"
	},
	"workspaces": [
		"tools/api-contracts"
	],
	"overrides": {
		"runed": {
			"@sveltejs/kit": "^3.1.0"
		},
		"exceljs": {
			"uuid": "^11.1.1"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
