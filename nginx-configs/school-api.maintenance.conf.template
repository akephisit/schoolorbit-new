map $http_origin $maintenance_allow_origin {
    default "";
    "~^https://([\w-]+\.)?${BASE_DOMAIN_REGEX}(:[0-9]+)?$" $http_origin;
    "http://localhost:3000" $http_origin;
    "http://127.0.0.1:3000" $http_origin;
}

server {
    listen 80;
    server_name school-api.${BASE_DOMAIN};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name school-api.${BASE_DOMAIN};

    ssl_certificate /etc/nginx/ssl/schoolorbit-origin.pem;
    ssl_certificate_key /etc/nginx/ssl/schoolorbit-origin.key;

    add_header Access-Control-Allow-Origin $maintenance_allow_origin always;
    add_header Access-Control-Allow-Credentials "true" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-School-Subdomain" always;
    add_header Retry-After "60" always;
    add_header Cache-Control "no-store" always;

    location / {
        if ($request_method = OPTIONS) {
            return 503;
        }

        default_type application/json;
        return 503 '{"success":false,"error":"maintenance","message":"ระบบกำลังปรับปรุง กรุณาลองใหม่อีกครั้ง"}';
    }
}
