# Runtime login: DML only. Certificate must match the database hostname/IP.
DATABASE_URL=postgresql://schoolorbit_admin_runtime:REPLACE@db.example.com/schoolorbit_admin?sslmode=verify-full&sslrootcert=/run/secrets/postgresql-ca.crt
# Migration job only; excluded from the normal service environment.
ADMIN_MIGRATION_DATABASE_URL=postgresql://schoolorbit_admin_owner:REPLACE@db.example.com/schoolorbit_admin?sslmode=verify-full&sslrootcert=/run/secrets/postgresql-ca.crt
PG_PROVISIONING_DATABASE_URL=postgresql://schoolorbit_provisioner:REPLACE@db.example.com/postgres?sslmode=verify-full&sslrootcert=/run/secrets/postgresql-ca.crt
# No tenant password in this template; Admin inserts the appropriate role/password.
PG_TENANT_DATABASE_URL=postgresql://db.example.com/postgres?sslmode=verify-full&sslrootcert=/run/secrets/postgresql-ca.crt
POSTGRES_CA_FILE=/opt/stack/postgresql/ca.crt
# Generate once using openssl rand -hex 32; preserve and back up the key.
DATABASE_CREDENTIALS_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=8080
RUST_LOG=info
# Note: CORS is handled by nginx reverse proxy

# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ACCOUNT_ID=your-account-id
BASE_DOMAIN=schoolorbit.app

# Backend-School Communication
BACKEND_SCHOOL_URL=http://backend-school:8081
INTERNAL_API_SECRET=your-internal-secret-change-this-in-production

# Deployment
API_URL=https://school-api.schoolorbit.app

# GitHub Actions Deployment
GITHUB_TOKEN=ghp_your-github-personal-access-token
GITHUB_REPO=akephisit/schoolorbit-new
# Optional but recommended: kept in sync with GITHUB_REPO for workflow polling paths
GITHUB_REPOSITORY=akephisit/schoolorbit-new
