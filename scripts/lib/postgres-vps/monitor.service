[Unit]
Description=SchoolOrbit PostgreSQL resource and recovery checks
After=postgresql.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/local/libexec/schoolorbit-postgres-status.py --cleanup
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/postgresql/18/main/log /var/log/pgbackrest
